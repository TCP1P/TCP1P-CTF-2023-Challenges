# check=skip=JSONArgsRecommended
FROM ubuntu:22.04

RUN apt update && apt upgrade -y && apt update --fix-missing
RUN apt-get install -y socat

WORKDIR /srv
COPY src/flag.txt ./flag.txt
COPY dist/ojou ./ojou

RUN chown -R 755 /srv
RUN chmod 700 /usr/bin/* /bin/* /tmp /dev/shm
RUN chmod 755 /usr/bin/env /bin/dash /bin/bash /bin/sh /bin/cat /usr/bin/id /bin/ls
RUN chmod +x /srv/ojou

EXPOSE 6666
CMD socat TCP-LISTEN:6666,reuseaddr,fork EXEC:/srv/ojou,su=nobody

# RSCTF dynamic-flag compatibility layer. The build-time scan records
# exact marker-bearing files; runtime replacement is therefore bounded
# to those files instead of walking the image on every team start.
USER root
COPY rsctf-entrypoint.sh /usr/local/bin/rsctf-entrypoint
RUN set -eu; \
    chmod 0555 /usr/local/bin/rsctf-entrypoint; \
    : > /etc/rsctf-flag-targets; \
    for root in /srv/ojou /srv/flag.txt /app /src /srv /home /opt /var/www /challenge /chall /ctf /root /usr/src /usr/local/bin /workspace /flag /flag.txt; do \
      if [ -e "$root" ]; then \
        find "$root" -xdev -type f ! -path /usr/local/bin/rsctf-entrypoint -exec grep -lF -e RSCTF_DYNAMIC_FLAG_c6c2827987799cae39bdb649f3347bc192951dd -e RSCTF_DYNAMIC_FLAG_3e44c73e4497a6b56f50bf6260ca0143 {} + >> /etc/rsctf-flag-targets 2>/dev/null || true; \
      fi; \
    done; \
    sort -u /etc/rsctf-flag-targets > /etc/rsctf-flag-targets.sorted; \
    mv /etc/rsctf-flag-targets.sorted /etc/rsctf-flag-targets; \
    while IFS= read -r target; do [ -f "$target" ] && chmod a+w "$target"; done < /etc/rsctf-flag-targets
ENTRYPOINT ["/usr/local/bin/rsctf-entrypoint"]
